APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Pusher (set BROADCAST_CONNECTION=pusher when using real-time chat)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https

# Agora RTC (video/voice in doctor session; required if your tooling validates .env keys)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MyFatoorah (patient checkout) — see config/myfatoorah.php
# Prefer MYFATOORAH_API_KEY; legacy Mashorapwa projects used MYFATOORAH_TOKEN + MYFATOORAH_MODE.
# MYFATOORAH_API_KEY=
# MYFATOORAH_TOKEN=
# MYFATOORAH_MODE=test
# MYFATOORAH_TEST_MODE=
# MYFATOORAH_COUNTRY=SAU
# MYFATOORAH_SAVE_CARD=true
# MYFATOORAH_WEBHOOK_SECRET=
# MYFATOORAH_REGISTER_APPLE_PAY=false

# SMS OTP (production): Saudi numbers use Dreams.sa; others use Twilio Verify — see App\Services\SmsService
# Set SMS_LIVE=true to send real SMS even when APP_ENV is local/staging.
# SMS_LIVE=false
# DREAMS_SMS_USER=
# DREAMS_SMS_SECRET_KEY=
# DREAMS_SMS_SENDER=MshoraMD
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM=

# Patient booking: optional explicit doctor id; if unset, first approved doctor in DB is used for catalog → book flow
# PATIENT_BOOKING_DEMO_DOCTOR_ID=149

# Doctor portal (routes under /doctor) — see config/doctor.php
# When true, /doctor/register requires a valid signed URL (Mashorapwa-prod style).
# DOCTOR_REGISTRATION_INVITE_ONLY=true
